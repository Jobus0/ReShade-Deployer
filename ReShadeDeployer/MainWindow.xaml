<ui:FluentWindow x:Class="ReShadeDeployer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:rd="clr-namespace:ReShadeDeployer"
                 xmlns:conv="clr-namespace:ReShadeDeployer.Converters"
                 mc:Ignorable="d"
                 ResizeMode="NoResize"
                 Icon="ReShade.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#222"
                 Title="ReShade Deployer"
                 FontSize="13"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 MinWidth="300" Width="340">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <Style x:Key="ApiBoldStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <StackPanel.Resources>
            <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Padding" Value="14 5" />
                <Setter Property="Border.CornerRadius" Value="8" />
            </Style>
        </StackPanel.Resources>
        <ui:TitleBar DockPanel.Dock="Top" Title="ReShade Deployer" Icon="{ui:ImageIcon ReShade.ico}" ShowMaximize="False" CanMaximize="False" Padding="14 0" />
        <DockPanel Height="28" Margin="25 0 25 3" LastChildFill="False">
            <Label VerticalAlignment="Center" DockPanel.Dock="Left" Padding="0 0 3 0" Content="{x:Static rd:UIStrings.VersionPrefix}" />
            <Label VerticalAlignment="Center" DockPanel.Dock="Left" Padding="0" FontWeight="SemiBold" Content="{Binding Updater.VersionLabelContent}" />
            <ui:Button VerticalAlignment="Center" DockPanel.Dock="Left" Padding="3, 2, 5, 3" Margin="5 0"
                       FontSize="12" FontWeight="Bold"
                       Visibility="{Binding Updater.UpdateButtonVisibility}"
                       ToolTip="{x:Static rd:UIStrings.UpdateReShade_Tooltip}"
                       Command="{Binding Updater.UpdateReShadeCommand}"
                       IsEnabled="{Binding Updater.IsUpdateEnabled}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDownload16" Margin="0,0,2,0" />
                    <TextBlock Text="{Binding Updater.UpdateButtonContent}" />
                </StackPanel>
            </ui:Button>

            <ui:DropDownButton Name="SettingsButton" VerticalAlignment="Center" DockPanel.Dock="Right" Padding="7, 3, 8, 2" FontSize="16"
                               Icon="{ui:SymbolIcon Settings16}" Appearance="Transparent" Background="Transparent" BorderThickness="0"
                               ToolTip="{x:Static rd:UIStrings.Settings_Tooltip}">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="{x:Static rd:UIStrings.ContextMenuDeploy}" IsCheckable="True" IsChecked="{Binding Settings.IsContextMenuRegistered}"
                                  ToolTip="{x:Static rd:UIStrings.ContextMenuDeploy_Tooltip}" />
                        <MenuItem Header="{x:Static rd:UIStrings.ExitOnDeploy}" IsCheckable="True" IsChecked="{Binding Settings.IsAlwaysExitOnDeploy}"
                                  ToolTip="{x:Static rd:UIStrings.ExitOnDeploy_Tooltip}" />
                        <Separator />
                        <MenuItem Header="{x:Static rd:UIStrings.DownloadLatestVersion_Title}" HeaderStringFormat="{}{0}..." Command="{Binding Updater.UpdateReShadeCommand}" />
                        <MenuItem Header="{x:Static rd:UIStrings.DownloadSpecificVersion_Title}" HeaderStringFormat="{}{0}..." Command="{Binding Updater.DownloadSpecificVersionCommand}" />
                        <Separator />
                        <MenuItem Header="{x:Static rd:UIStrings.UpdateDeployer}" HeaderStringFormat="{}{0}..." Command="{Binding Updater.CheckForDeployerUpdateCommand}" />
                        <Separator />
                        <MenuItem Header="{x:Static rd:UIStrings.UninstallDeployer}" HeaderStringFormat="{}{0}..." Command="{Binding Settings.UninstallCommand}" />
                        <MenuItem Header="{x:Static rd:UIStrings.About}" HeaderStringFormat="{}{0}..." Command="{Binding Settings.ShowAboutCommand}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </DockPanel>
        <Separator />
        <Grid Background="#30000000">
            <StackPanel Margin="15" IsEnabled="{Binding Updater.IsPanelEnabled}">
                <ui:Card Margin="0, 0, 0, 10" Padding="14 5 5 5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document16" Margin="0,0,5,0"
                                           Visibility="{Binding SelectedGameIcon, Converter={StaticResource NullToVisibility}}" />
                            <ui:ImageIcon Source="{Binding SelectedGameIcon}" Margin="0,0,5,0" Width="16" Height="16"
                                          Visibility="{Binding SelectedGameIcon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                            <ui:TextBlock Text="{Binding SelectedGameText}" ToolTip="{Binding SelectedGameTooltip}"
                                          VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="{Binding SelectGameButtonAppearance}" Margin="5 0 0 0"
                                   Content="{x:Static rd:UIStrings.Browse}" Click="SelectGameButton_OnClick" />
                        <ui:Button Name="ExecutableInfoButton" Grid.Column="2" Icon="{ui:SymbolIcon Info16}" IsEnabled="{Binding IsExecutableInfoEnabled}"
                                   Visibility="Collapsed" Margin="3 0 0 0" Padding="4" Command="{Binding ShowExecutableInfoCommand}" />
                    </Grid>
                </ui:Card>
                <TextBlock Text="{x:Static rd:UIStrings.TargetAPI}" ToolTip="{x:Static rd:UIStrings.TargetAPI_Tooltip}" FontWeight="SemiBold" Margin="10 0" />
                <ui:Card Margin="0, 0, 0, 10">
                    <StackPanel>
                        <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.DirectX10}" ToolTip="{x:Static rd:UIStrings.DirectX10_Tooltip}"
                                     IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.DXGI}}"
                                     Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.DXGI}}"
                                     Style="{StaticResource ApiBoldStyle}" />
                        <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.DirectX9}" ToolTip="{x:Static rd:UIStrings.DirectX9_Tooltip}"
                                     IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.D3D9}}"
                                     Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.D3D9}}"
                                     Style="{StaticResource ApiBoldStyle}" />
                        <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.OpenGL}" ToolTip="{x:Static rd:UIStrings.OpenGL_Tooltip}"
                                     IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.OpenGL}}"
                                     Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.OpenGL}}"
                                     Style="{StaticResource ApiBoldStyle}" />
                        <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.Vulkan}" ToolTip="{x:Static rd:UIStrings.Vulkan_Tooltip}"
                                     IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.Vulkan}}"
                                     Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.Vulkan}}"
                                     Style="{StaticResource ApiBoldStyle}" />
                    </StackPanel>
                </ui:Card>
                <TextBlock Text="{x:Static rd:UIStrings.Addons}" FontWeight="SemiBold" Margin="10 0" />
                <ui:Card Margin="0, 0, 0, 14">
                    <StackPanel>
                        <CheckBox Margin="0 0 0 0" Padding="0" FontSize="13" Content="{x:Static rd:UIStrings.Addon}" ToolTip="{x:Static rd:UIStrings.Addon_Tooltip}"
                                  IsChecked="{Binding Addons.IsAddonSupportChecked}" Command="{Binding ToggleAddonSupportCommand}" />
                        <Grid Margin="0 6 0 6" Visibility="{Binding Addons.IsAddonsComboVisible, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox FontSize="13" HorizontalAlignment="Stretch" ItemsSource="{Binding Addons.Addons}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AddonItem_OnUserClick" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSupported}"
                                                      IsHitTestVisible="False" Margin="5,2" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding Addons.AddonsSummaryText}" Margin="12,0,25,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                <Grid Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsEnabled="{Binding IsDeployEnabled}" Appearance="Primary"
                               ToolTip="{x:Static rd:UIStrings.DeployButton_Tooltip}"
                               Command="{Binding DeployCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static rd:UIStrings.DeployButton}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="1" VerticalAlignment="Stretch" Padding="12" Margin="5,0,0,0" Appearance="Danger"
                               Visibility="{Binding IsUndeployVisible, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="{x:Static rd:UIStrings.UndeployButton_Tooltip}"
                               Command="{Binding UndeployCommand}">
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button>
                </Grid>
            </StackPanel>
            <ui:SnackbarPresenter x:Name="SnackbarPresenter" Panel.ZIndex="1000">
                <ui:SnackbarPresenter.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="Themes/SnackbarStyle.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </ui:SnackbarPresenter.Resources>
            </ui:SnackbarPresenter>
        </Grid>
    </StackPanel>
</ui:FluentWindow>
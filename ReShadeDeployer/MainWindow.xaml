<ui:UiWindow x:Class="ReShadeDeployer.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:rd="clr-namespace:ReShadeDeployer"
             xmlns:conv="clr-namespace:ReShadeDeployer.Converters"
             mc:Ignorable="d"
             ResizeMode="NoResize"
             Icon="ReShade.ico"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             Title="ReShade Deployer"
             FontSize="13"
             SizeToContent="Height"
             WindowStartupLocation="CenterScreen"
             MinWidth="300" Width="300">
    <ui:UiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <Style x:Key="ApiBoldStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiWindow.Resources>
    <StackPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="ReShade Deployer" Icon="ReShade.ico" ShowMaximize="False" CanMaximize="False" Padding="7" />
        <Separator />
        <DockPanel Height="28" LastChildFill="False">
            <Label VerticalAlignment="Center" Padding="15 0 3 0" Content="{x:Static rd:UIStrings.VersionPrefix}" />
            <Label VerticalAlignment="Center" Padding="0" FontWeight="Bold" Content="{Binding Updater.VersionLabelContent}" />
            <ui:Button Name="SettingsButton" VerticalAlignment="Stretch" DockPanel.Dock="Right" Padding="7, 0, 8, 0" Icon="Settings16" Appearance="Transparent" BorderThickness="1, 0, 0, 0" CornerRadius="0"
                       ToolTip="{x:Static rd:UIStrings.Settings_Tooltip}" Click="SettingsButton_OnClick">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static rd:UIStrings.ContextMenuDeploy}" IsCheckable="True" IsChecked="{Binding Settings.IsContextMenuRegistered}"
                                  ToolTip="{x:Static rd:UIStrings.ContextMenuDeploy_Tooltip}" />
                        <MenuItem Header="{x:Static rd:UIStrings.AlwaysExitOnDeploy}" IsCheckable="True" IsChecked="{Binding Settings.IsAlwaysExitOnDeploy}"
                                  ToolTip="{x:Static rd:UIStrings.AlwaysExitOnDeploy_Tooltip}" />
                        <Separator/>
                        <MenuItem Header="{x:Static rd:UIStrings.DownloadSpecificVersion_Title}" HeaderStringFormat="{}{0}..." Command="{Binding Updater.DownloadSpecificVersionCommand}" />
                        <MenuItem Header="{x:Static rd:UIStrings.UpdateDeployer}" HeaderStringFormat="{}{0}..." Command="{Binding Updater.CheckForDeployerUpdateCommand}" />
                        <MenuItem Header="{x:Static rd:UIStrings.UninstallDeployer}" HeaderStringFormat="{}{0}..." Command="{Binding Settings.UninstallCommand}" />
                        <MenuItem Header="{x:Static rd:UIStrings.About}" HeaderStringFormat="{}{0}..." Command="{Binding Settings.ShowAboutCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </ui:Button>
            <ui:Button VerticalAlignment="Stretch" DockPanel.Dock="Right" Padding="7, 0, 8, 0" Icon="ArrowDownload16" FontSize="12" FontWeight="Bold" Appearance="Transparent" BorderThickness="1, 0, 0, 0" CornerRadius="0"
                       ToolTip="{x:Static rd:UIStrings.UpdateReShade_Tooltip}" Command="{Binding Updater.UpdateReShadeCommand}" Content="{Binding Updater.UpdateButtonContent}" IsEnabled="{Binding Updater.IsUpdateEnabled}" />
        </DockPanel>
        <Separator />
        <StackPanel Margin="12" IsEnabled="{Binding Updater.IsPanelEnabled}">
            <Grid Margin="0, 0, 0, 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button HorizontalAlignment="Stretch" Icon="Open16" Appearance="{Binding SelectGameButtonAppearance}" ClipToBounds="True" Margin="0, 0, 1, 0" Click="SelectGameButton_OnClick">
                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectGameButtonText}" ToolTip="{Binding SelectGameButtonText}" FontSize="13"/>
                </ui:Button>
                <ui:Button Name="ExecutableInfoButton" Grid.Column="1" Icon="Info16" IsEnabled="{Binding IsExecutableInfoEnabled}" Visibility="Collapsed" Margin="3, 0, 0, 0" Padding="4" Command="{Binding ShowExecutableInfoCommand}"/>
            </Grid>
            <GroupBox Header="{x:Static rd:UIStrings.TargetAPI}" Padding="3, 0" BorderThickness="0" Background="#44000000" ToolTip="{x:Static rd:UIStrings.TargetAPI_Tooltip}">
                <StackPanel>
                    <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.DirectX10}" ToolTip="{x:Static rd:UIStrings.DirectX10_Tooltip}"
                                 IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.DXGI}}"
                                 Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.DXGI}}"
                                 Style="{StaticResource ApiBoldStyle}" />
                    <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.DirectX9}" ToolTip="{x:Static rd:UIStrings.DirectX9_Tooltip}"
                                 IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.D3D9}}"
                                 Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.D3D9}}"
                                 Style="{StaticResource ApiBoldStyle}" />
                    <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.OpenGL}" ToolTip="{x:Static rd:UIStrings.OpenGL_Tooltip}"
                                 IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.OpenGL}}"
                                 Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.OpenGL}}"
                                 Style="{StaticResource ApiBoldStyle}" />
                    <RadioButton FontSize="13" Content="{x:Static rd:UIStrings.Vulkan}" ToolTip="{x:Static rd:UIStrings.Vulkan_Tooltip}"
                                 IsChecked="{Binding SelectedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.Vulkan}}"
                                 Tag="{Binding HighlightedApi, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static rd:GraphicsApi.Vulkan}}"
                                 Style="{StaticResource ApiBoldStyle}" />
                </StackPanel>
            </GroupBox>
            <CheckBox Margin="7 7 7 0" FontSize="13" Content="{x:Static rd:UIStrings.Addon}" ToolTip="{x:Static rd:UIStrings.Addon_Tooltip}" IsChecked="{Binding Addons.IsAddonSupportChecked}" Command="{Binding ToggleAddonSupportCommand}" />
            <Grid Margin="7,2,7,7" Visibility="{Binding Addons.IsAddonsComboVisible, Converter={StaticResource BoolToVisibility}}">
                <ComboBox FontSize="13" HorizontalAlignment="Stretch" ItemsSource="{Binding Addons.Addons}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AddonItem_OnUserClick" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSupported}" 
                                          IsHitTestVisible="False" Margin="5,2" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding Addons.AddonsSummaryText}" Margin="12,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid Margin="0 7 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Height="50" HorizontalAlignment="Stretch" IsEnabled="{Binding IsDeployEnabled}" Appearance="Primary" Content="{Binding DeployButtonContent}" ToolTip="{x:Static rd:UIStrings.DeployButton_Tooltip}" Command="{Binding DeployCommand}">
                </ui:Button>
                <ui:Button Grid.Column="1" Padding="12" Margin="5,0,0,0" Appearance="Danger"
                           Visibility="{Binding IsUndeployVisible, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="{x:Static rd:UIStrings.UndeployButton_Tooltip}" 
                           Command="{Binding UndeployCommand}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:UiWindow>